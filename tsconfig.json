{
    "compilerOptions": {
        "rootDir": ".",
        "esModuleInterop": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ES6",
        "allowJs": true,
        "noImplicitAny": true,
        "moduleResolution": "bundler",
        "importHelpers": false,
        "isolatedModules": true,
        "strictNullChecks": true,
        
        "lib": ["DOM", "ES5", "ES6", "ES2017", "ESNext"],
        "types": ["jest"]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
